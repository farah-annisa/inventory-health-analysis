	partition 'Reorder Points' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(Text.TrimEnd(DataFolder, {"\", "/"}) & "\reorder_points.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"item_id", type text}, {"dept_id", type text}, {"cat_id", type text}, {"store_id", type text}, {"state_id", type text}, {"abc", type text}, {"xyz", type text}, {"lead_time_days", Int64.Type}, {"avg_daily_demand", type number}, {"sd_daily_demand", type number}, {"safety_stock_units", type number}, {"reorder_point_units", type number}}, "en-US"),
				    WithSegment = Table.AddColumn(Typed, "segment", each [abc] & [xyz], type text)
				in
				    WithSegment

	annotation PBI_ResultType = Table

